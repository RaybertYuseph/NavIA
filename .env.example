# Copia este archivo a .env.local y rellena los valores de tu proyecto Supabase
# (Project Settings → API). Solo las variables NEXT_PUBLIC_ llegan al navegador.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Login: 'password' (correo y contraseña, por defecto) u 'otp' (código al correo,
# requiere SMTP y la plantilla supabase/templates/codigo.html).
NEXT_PUBLIC_LOGIN_MODE=password

# Solo servidor. Aún no la usa el corte 1; la necesitará Norbit (Sprint 6).
SUPABASE_SERVICE_ROLE_KEY=

# Norbit (Sprint 6)
DEEPSEEK_API_KEY=

# Avisos push (Sprint 6)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
