# Copia este archivo a .env.local y rellena los valores de tu proyecto Supabase
# (Project Settings → API). Solo las variables NEXT_PUBLIC_ llegan al navegador.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Login: 'password' (correo y contraseña, por defecto) u 'otp' (código al correo,
# requiere SMTP y la plantilla supabase/templates/codigo.html).
NEXT_PUBLIC_LOGIN_MODE=password

# Demo para presentaciones: muestra en /login los botones "Entrar como fiscal / conductor /
# estudiante". Las tres cuentas (fiscal@, conductor@, estudiante@navia.test) usan esta
# contraseña, que queda visible en el navegador: no uses estas cuentas con datos reales.
NEXT_PUBLIC_DEMO=0
NEXT_PUBLIC_DEMO_PASSWORD=

# Solo servidor y hoy sin uso: salta toda la RLS. Nunca con prefijo NEXT_PUBLIC_ ni en el agente
# NavIA (el agente consulta con la sesión del usuario, así ve solo lo que ese usuario puede ver).
SUPABASE_SERVICE_ROLE_KEY=

# Agente NavIA (Sprint 6)
DEEPSEEK_API_KEY=

# Avisos push (Sprint 6)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

